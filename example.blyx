use sloburn;

fn main() {
    let bad = 4.0;
    let total = 100.0;
    let allowed = 0.02;
    let result = sloburn_rate(bad, total, allowed);
    if len(result) == 0 { println!("invalid"); return; }
    let mut i = 0;
    while i < len(result) {
        println!(at(result, i));
        i += 1;
    }
}
